# Universal Benchmark Container (Spack Edition)
# Portable performance benchmarks with Spack-managed GCC for broad compatibility
FROM ubuntu:24.04

LABEL maintainer="AWS Instance Benchmarks <benchmarks@computecompass.dev>"
LABEL version="2.1.0-spack"
LABEL description="Universal benchmark suite with GCC optimizations via Spack"
LABEL architecture="Universal (x86_64, ARM64)"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    unzip \
    bc \
    util-linux \
    jq \
    git \
    build-essential \
    python3 \
    python3-pip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Spack and configure AWS binary cache
RUN git clone -c feature.manyFiles=true https://github.com/spack/spack.git /opt/spack && \
    . /opt/spack/share/spack/setup-env.sh && \
    spack mirror add aws-graviton https://cache.spack.io/oci && \
    spack buildcache keys --install --trust

# Install modern GCC 13 with broad compatibility
RUN . /opt/spack/share/spack/setup-env.sh && \
    spack install --cache-only gcc@13 || \
    spack install gcc@13

# Install portable OpenBLAS 
RUN . /opt/spack/share/spack/setup-env.sh && \
    spack install --cache-only openblas@0.3.26+shared threads=openmp || \
    spack install openblas@0.3.26+shared threads=openmp

# Setup Spack environment in shell startup
RUN echo '. /opt/spack/share/spack/setup-env.sh' >> /etc/bash.bashrc && \
    echo 'spack load gcc@13' >> /etc/bash.bashrc && \
    echo 'spack load openblas' >> /etc/bash.bashrc

# Set portable compiler environment
ENV CC="gcc"
ENV CXX="g++" 
ENV FC="gfortran"

# Universal optimization flags (portable across architectures)
ENV CFLAGS="-O3 -march=native -mtune=native -fopenmp -ffast-math -funroll-loops"
ENV CXXFLAGS="-O3 -march=native -mtune=native -fopenmp -ffast-math -funroll-loops"
ENV FCFLAGS="-O3 -march=native -mtune=native -fopenmp -ffast-math -funroll-loops"

# OpenBLAS linking (will be set after Spack load)
ENV LDFLAGS="-lopenblas -lm -fopenmp"

# Universal threading optimization
ENV OMP_NUM_THREADS="auto"
ENV OMP_PROC_BIND="close"
ENV OMP_PLACES="cores"

# Create benchmark workspace
WORKDIR /opt/benchmarks

# Copy universal detection script
COPY builds/universal/comprehensive/scripts/detect-and-optimize.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/detect-and-optimize.sh

# Copy benchmark sources
COPY builds/universal/comprehensive/benchmarks/ ./

# Copy universal build scripts
COPY builds/universal/comprehensive/scripts/build-benchmarks.sh ./
COPY builds/universal/comprehensive/scripts/version-collector.sh ./scripts/
COPY builds/universal/comprehensive/scripts/run-benchmark-spack.sh /usr/local/bin/run-benchmark.sh

# Set executable permissions
RUN chmod +x ./build-benchmarks.sh ./scripts/version-collector.sh /usr/local/bin/run-benchmark.sh

# Build benchmarks with Spack-managed universal optimizations
RUN bash -c ". /opt/spack/share/spack/setup-env.sh && spack load gcc@13 openblas && ./build-benchmarks.sh"

# Validate installation
RUN bash -c ". /opt/spack/share/spack/setup-env.sh && spack load gcc@13 openblas && ls -la stream/ linpack/ coremark/ && echo 'Universal Spack build complete'"

# Container metadata
ENV CONTAINER_VERSION="2.1.0-spack"
ENV CONTAINER_VARIANT="universal-spack-optimized"
ENV OPTIMIZATION_PROFILE="Universal GCC + OpenBLAS portable performance via Spack"

# Set default command to execute with runtime architecture detection
ENTRYPOINT ["/usr/local/bin/detect-and-optimize.sh"]
CMD ["all"]
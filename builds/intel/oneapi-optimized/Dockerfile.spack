# Intel oneAPI Optimized Container (Spack Edition)
# Simple Ubuntu 24.04 + Spack + Intel oneAPI compilers
FROM ubuntu:24.04

LABEL maintainer="AWS Instance Benchmarks <benchmarks@computecompass.dev>"
LABEL version="2.1.0-spack"
LABEL description="Intel oneAPI optimized benchmark suite via Spack"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    unzip \
    bc \
    util-linux \
    jq \
    git \
    build-essential \
    python3 \
    python3-pip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Spack
RUN git clone -c feature.manyFiles=true https://github.com/spack/spack.git /opt/spack && \
    . /opt/spack/share/spack/setup-env.sh && \
    spack mirror add binary_mirror https://binaries.spack.io/develop && \
    spack buildcache keys --install --trust

# Install Intel oneAPI compilers from binary cache only
RUN . /opt/spack/share/spack/setup-env.sh && \
    spack install --cache-only intel-oneapi-compilers

# Install Intel MKL from binary cache only
RUN . /opt/spack/share/spack/setup-env.sh && \
    spack install --cache-only intel-oneapi-mkl

# Setup Spack environment
RUN echo '. /opt/spack/share/spack/setup-env.sh' >> /etc/bash.bashrc && \
    echo 'spack load intel-oneapi-compilers' >> /etc/bash.bashrc && \
    echo 'spack load intel-oneapi-mkl' >> /etc/bash.bashrc

# Create benchmark workspace
WORKDIR /opt/benchmarks

# Copy benchmark sources and scripts
COPY benchmarks/ ./
COPY builds/intel/oneapi-optimized/scripts/build-benchmarks-intel.sh ./
COPY builds/intel/oneapi-optimized/scripts/version-collector-intel.sh ./scripts/
COPY builds/intel/oneapi-optimized/scripts/run-benchmark-intel-spack.sh /usr/local/bin/run-benchmark-intel.sh

# Set executable permissions
RUN chmod +x ./build-benchmarks-intel.sh ./scripts/version-collector-intel.sh /usr/local/bin/run-benchmark-intel.sh

# Build benchmarks
RUN bash -c ". /opt/spack/share/spack/setup-env.sh && spack load intel-oneapi-compilers intel-oneapi-mkl && ./build-benchmarks-intel.sh"

# Container metadata
ENV CONTAINER_VERSION="2.1.0-spack"
ENV CONTAINER_VARIANT="intel-oneapi-spack-optimized"

# Set default command
CMD ["run-benchmark-intel.sh"]
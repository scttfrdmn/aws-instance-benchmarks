# Intel oneAPI Optimized Container (Official Intel Base)
# Uses Intel's official oneAPI container with Spack for additional packages
FROM intel/oneapi-basekit:2025.1.0-0-devel-ubuntu22.04

LABEL maintainer="AWS Instance Benchmarks <benchmarks@computecompass.dev>"
LABEL version="2.1.0-spack"
LABEL description="Intel oneAPI optimized benchmark suite via Spack"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    unzip \
    bc \
    util-linux \
    jq \
    git \
    build-essential \
    python3 \
    python3-pip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Spack
RUN git clone -c feature.manyFiles=true https://github.com/spack/spack.git /opt/spack && \
    . /opt/spack/share/spack/setup-env.sh && \
    spack mirror add binary_mirror https://binaries.spack.io/develop && \
    spack buildcache keys --install --trust

# Intel oneAPI already installed in base image - just setup environment
ENV ONEAPI_ROOT=/opt/intel/oneapi
RUN echo 'source /opt/intel/oneapi/setvars.sh' >> /etc/bash.bashrc

# Setup Spack environment (oneAPI compilers already available from base image)
RUN echo '. /opt/spack/share/spack/setup-env.sh' >> /etc/bash.bashrc

# Create benchmark workspace
WORKDIR /opt/benchmarks

# Copy benchmark sources and scripts
COPY builds/universal/comprehensive/benchmarks/ ./
COPY builds/intel/oneapi-optimized/scripts/build-benchmarks-intel.sh ./
COPY builds/intel/oneapi-optimized/scripts/version-collector-intel.sh ./scripts/
COPY builds/intel/oneapi-optimized/scripts/intel-optimize.sh /usr/local/bin/
COPY builds/intel/oneapi-optimized/scripts/run-benchmark-intel-spack.sh /usr/local/bin/run-benchmark-intel.sh

# Set executable permissions
RUN chmod +x ./build-benchmarks-intel.sh ./scripts/version-collector-intel.sh /usr/local/bin/intel-optimize.sh /usr/local/bin/run-benchmark-intel.sh

# Build benchmarks
RUN bash -c "source /opt/intel/oneapi/setvars.sh --force && ./build-benchmarks-intel.sh"

# Container metadata
ENV CONTAINER_VERSION="2.1.0-spack"
ENV CONTAINER_VARIANT="intel-oneapi-spack-optimized"

# Set default command
CMD ["run-benchmark-intel.sh"]